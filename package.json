{
  "name": "mock-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "backend:run": "mvn -f backend/pom.xml spring-boot:run",
    "backend:run:postgres": "mvn -f backend/pom.xml spring-boot:run -Dspring-boot.run.profiles=postgres",
    "backend:test": "mvn -f backend/pom.xml test",
    "neon:smoke": "node --env-file=.env data/neon/smoke-services.mjs",
    "neon:smoke:assets": "set NEON_STORAGE_BUCKET=assets&& node --env-file=.env data/neon/smoke-services.mjs",
    "neon:diagnose": "powershell -ExecutionPolicy Bypass -File ./data/neon/diagnose-connectivity.ps1",
    "db:seed": "npx tsx data/seed-users.js",
    "databricks:sync-access": "node --env-file=.env data/sync-databricks-access.mjs",
    "databricks:discover": "node --env-file=.env data/sync-databricks-access.mjs --discover",
    "databricks:upload-local-vin": "node --env-file=.env data/upload-local-vin-csv.mjs",
    "databricks:validate-local-vin": "node --env-file=.env data/upload-local-vin-csv.mjs --validate-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@databricks/sdk-postgres": "^0.52.6",
    "@databricks/sql": "^2.4.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "csv-parse": "^7.0.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite3": "^6.0.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "node-gyp@12.4.0": true
  }
}
